# Alpaca PAPER keys (Alpaca dashboard -> Paper Trading -> API Keys). Copy to .env, never commit .env.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
# optional: protect the dashboard when it listens beyond localhost
DASHBOARD_TOKEN=
# optional: Telegram push messages (telegram-setup.bat fills these in)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
