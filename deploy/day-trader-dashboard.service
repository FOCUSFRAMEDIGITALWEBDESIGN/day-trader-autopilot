[Unit]
Description=Day Trader Autopilot dashboard
After=network-online.target

[Service]
WorkingDirectory=/opt/day-trader-autopilot
EnvironmentFile=/opt/day-trader-autopilot/.env
ExecStart=/usr/bin/python3 dashboard/server.py --host 127.0.0.1 --port 8765
Restart=always

[Install]
WantedBy=multi-user.target
